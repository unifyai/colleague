__pycache__/
*.py[cod]
*.egg-info/
.venv/
.env
*.key

# OpenCode's CLI log and state tree are the one arm whose artifacts inline a
# *resolved* provider config: its local DB stores the substituted API key
# rather than the `{env:OPENROUTER_API_KEY}` reference written into the
# config file. They are never benchmark evidence, and must not reach a public
# tree. (OpenClaw and hermes persist the env reference instead, so their
# state trees are committed as evidence and scanned clean.)
colleague/tracks/*/*/results/*/opencode_cli.log
colleague/tracks/*/*/results/*/opencode_state/

# Sqlite state carries no readable evidence and is awkward to audit by eye.
colleague/tracks/*/*/results/*/**/*.sqlite
colleague/tracks/*/*/results/*/**/*.db

# Raw request bodies: kept locally for offline replay, too large to commit.
colleague/tracks/*/*/results/*/requests.jsonl

# Mock-arm runs are self-test output, not evidence: they make no LLM calls
# and prove things about the suite rather than about any harness.
colleague/tracks/*/results/*-mock/

# Track results are run artifacts, not evidence: CI uploads them and the
# aggregate reads them from there. Committing a local debugging run means
# every future shard re-uploads it, and stale results from an older code
# version get merged into a fresh sweep as if they were part of it.
# (standing/ keeps its committed results — they are the published record,
# and they live one level deeper so this does not match them.)
colleague/tracks/*/results/
