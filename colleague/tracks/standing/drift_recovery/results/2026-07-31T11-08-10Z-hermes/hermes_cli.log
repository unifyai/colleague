+import importlib.util
+import json
+from pathlib import Path
+
+SCRIPT = Path("/Users/djl11/unify/benchmarks/drift_recovery/results/2026-07-31T11-08-10Z-hermes/hermes_home/scripts/process_orders_batch.py")
+spec = importlib.util.spec_from_file_location("process_orders_batch", SCRIPT)
+module = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(module)
+
+
+class Response:
+    def __init__(self, payload=b""):
+        self.payload = payload
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, *_args):
+        return False
+
+    def read(self):
+        return self.payload
+
+
+def test_aggregates_and_posts_exact_payload(monkeypatch):
+    calls = []
+    responses = iter([
+        Response(json.dumps({"last_seq": 7}).encode()),
+        Response(json.dumps([
+            {"seq": 8, "date": "2026-07-31", "region": "west", "units": 2, "unit_price_cents": 150},
+            {"seq": 9, "date": "2026-07-31", "region": "east", "units": 3, "unit_price_cents": 200},
+            {"seq": 10, "date": "2026-07-31", "region": "west", "units": 1, "unit_price_cents": 400},
+        ]).encode()),
+        Response(),
+    ])
+
+    def fake_urlopen(request, timeout):
+        calls.append((request, timeout))
+        return next(responses)
+
+    monkeypatch.setattr(module.urllib.request, "urlopen", fake_urlopen)
+    assert module.main() == 0
+    assert [request.full_url for request, _ in calls] == [
+        "http://127.0.0.1:8127/batches/last",
+        "http://127.0.0.1:8127/orders?after=7",
+        "http://127.0.0.1:8127/batches",
+    ]
+    posted = json.loads(calls[2][0].data)
+    assert posted == {
+        "batch_start_seq": 8,
+        "batch_end_seq": 10,
+        "order_count": 3,
+        "total_units": 6,
+        "total_revenue_cents": 1300,
+        "revenue_by_region_cents": {"west": 700, "east": 600},
+    }
+    assert set(posted) == {
+        "batch_start_seq", "batch_end_seq", "order_count", "total_units",
+        "total_revenue_cents", "revenue_by_region_cents",
+    }
+
+
+def test_no_orders_does_not_post(monkeypatch):
+    calls = []
+    responses = iter([
+        Response(json.dumps({"last_seq": 10}).encode()),
+        Response(b"[]"),
+    ])
+
+    def fake_urlopen(request, timeout):
+        calls.append(request)
+        return next(responses)
+
+    monkeypatch.setattr(module.urllib.request, "urlopen", fake_urlopen)
+    assert module.main() == 0
+    assert len(calls) == 2
+    assert calls[1].full_url.endswith("/orders?after=10")
