# The throwaway HERMES_HOME contains bundled tooling (lsp/, bin/), the stock
# skills bundle, caches and state DBs — none of it benchmark evidence. Keep
# only the artifacts the agent authored plus the run docs.
hermes_home/*
!hermes_home/scripts/
hermes_home/scripts/__pycache__/
!hermes_home/cron/
hermes_home/cron/executions.db
!hermes_home/config.yaml
workspace/
