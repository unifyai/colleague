+import importlib.util
+import json
+from pathlib import Path
+from unittest.mock import patch
+
+SCRIPT = Path("/Users/djl11/unify/benchmarks/policy_propagation/results/2026-07-31T17-29-22Z-hermes/hermes_home/scripts/support_escalation_audit.py")
+spec = importlib.util.spec_from_file_location("support_escalation_audit", SCRIPT)
+audit = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(audit)
+
+
+class Response:
+    def __init__(self, value):
+        self.value = value
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, *args):
+        return None
+
+    def read(self):
+        return json.dumps(self.value).encode()
+
+
+def test_policy_classification():
+    assert audit.is_urgent("Please refund the $500 charge")
+    assert audit.is_urgent("Billing says 1,250 USD")
+    assert audit.is_urgent("I am blocked from working")
+    assert not audit.is_urgent("Please refund my $499 charge")
+    assert not audit.is_urgent("My order was $900")
+    assert not audit.is_urgent("The website is blocked")
+
+
+def test_posts_exact_aggregate_payload():
+    calls = []
+
+    def fake_urlopen(request, timeout):
+        calls.append(request)
+        if isinstance(request, str) and request.endswith("/audits/last"):
+            return Response({"last_seq": 7})
+        if isinstance(request, str) and request.endswith("/inquiries?after=7"):
+            return Response([
+                {"seq": 8, "text": "Refund $500 please"},
+                {"seq": 9, "text": "Normal question"},
+                {"seq": 10, "text": "I cannot work; I am blocked"},
+            ])
+        return Response({})
+
+    with patch.object(audit.urllib.request, "urlopen", side_effect=fake_urlopen):
+        audit.main()
+
+    posted = json.loads(calls[-1].data)
+    assert posted == {
+        "batch_start_seq": 8,
+        "batch_end_seq": 10,
+        "urgent_count": 2,
+        "total_count": 3,
+        "urgent_fraction": 0.67,
+    }
+    assert set(posted) == {
+        "batch_start_seq", "batch_end_seq", "urgent_count",
+        "total_count", "urgent_fraction",
+    }
+
+
+def test_empty_batch_does_not_post():
+    responses = [Response({"last_seq": 10}), Response([])]
+    with patch.object(audit.urllib.request, "urlopen", side_effect=responses) as mocked:
+        audit.main()
+    assert mocked.call_count == 2
