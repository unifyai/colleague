      "id": "6fd2919d-8e22-46ee-8f28-9a62094c5fe9",
      "agentId": "main",
      "sessionKey": "agent:main:explicit:benchmark-setup",
      "name": "Daily urgent customer inquiry digest",
      "description": "Summarize urgent support inquiries into category counts once daily.",
      "enabled": true,
      "deleteAfterRun": false,
      "createdAtMs": 1785539697556,
      "updatedAtMs": 1785539826022,
      "schedule": {
        "kind": "cron",
        "expr": "14 0 * * *",
        "tz": "Europe/London",
        "staggerMs": 0
      },
      "sessionTarget": "isolated",
      "wakeMode": "now",
      "payload": {
